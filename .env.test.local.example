# Test-mode credentials for Playwright E2E (npm run test:e2e).
#
# Copy to .env.test.local (already gitignored via .env*.local) and fill in
# TEST-MODE keys only. playwright.config.ts refuses to start the dev server
# if any *_live_ key is detected here — E2E must never touch production
# Clerk/Stripe.
#
# Get these from a Clerk "development" instance (dashboard.clerk.com) and a
# Stripe account in test mode (dashboard.stripe.com/test/apikeys) — NOT the
# same instance/account your .env.local live keys point at.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRO_PRICE_ID=price_test_xxx

# Fixed E2E test user, created (idempotently) by e2e/global-setup.ts against
# the Clerk dev instance above and deleted again by e2e/global-teardown.ts.
E2E_TEST_USER_EMAIL=e2e-test-user@joben.eu
E2E_TEST_USER_PASSWORD=Str0ng-E2E-Password!

# Everything else (Supabase, Upstash, Anthropic, Resend) reuses your local
# .env.local values — Supabase local dev is not "live" the way Clerk/Stripe
# are, so it's safe to share.
