# Sablon pentru dezvoltare locala. Copiaza in .env.local si completeaza.
# Nu comite niciodata valori reale. Lista completa pentru productie: .env.prod.example

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk (autentificare) - foloseste chei de dezvoltare pk_test_/sk_test_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_CHANGE_ME"
CLERK_SECRET_KEY="sk_test_CHANGE_ME"
CLERK_WEBHOOK_SECRET="whsec_CHANGE_ME"

# Supabase (din `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"

# Stripe (optional; fara el, platile sunt dezactivate) - doar chei de test
STRIPE_SECRET_KEY="sk_test_CHANGE_ME"
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"
STRIPE_PRO_PRICE_ID="price_CHANGE_ME"

# AI, email, rate limiting
ANTHROPIC_API_KEY="CHANGE_ME"
RESEND_API_KEY="CHANGE_ME"
RESEND_FROM_EMAIL="Joben <noreply@example.com>"
UPSTASH_REDIS_REST_URL="https://CHANGE_ME.upstash.io"
UPSTASH_REDIS_REST_TOKEN="CHANGE_ME"
CRON_SECRET="CHANGE_ME"

# Serviciul LaTeX (optional local)
LATEX_SERVICE_URL="http://localhost:3005/api/compile"
LATEX_SERVICE_SECRET="CHANGE_ME"

# Conturi cu acces complet la toate planurile (emailuri separate prin virgula); gol = nimeni
GOD_MODE_EMAILS=""
# Destinatarul raportului saptamanal (scripts/weekly-report.mjs)
REPORT_EMAIL=""

# PostHog (analytics in browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="CHANGE_ME"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# PostHog, upload source maps (doar la build)
POSTHOG_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_HOST=""
