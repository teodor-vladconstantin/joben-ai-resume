# joben-ai-resume — production environment variables
#
# Copy the vars you need into your deployment's env store (Vercel Dashboard
# for the Next.js app; the VPS docker-compose env for the LaTeX/resume-parser
# services). Never commit a file with real values — this file only holds
# placeholders. See src/lib/env.ts for how these are read/validated.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-production-domain.example"

# ---------------------------------------------------------------------------
# Clerk (auth) — required
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_CHANGE_ME"
CLERK_SECRET_KEY="sk_live_CHANGE_ME"
CLERK_WEBHOOK_SECRET="whsec_CHANGE_ME"
# Dev-only escape hatch for src/lib/env.ts's validateClerkLocalConfig() guard,
# which otherwise throws if a pk_live_/sk_live_ key is used with a localhost
# NEXT_PUBLIC_APP_URL. Never set this in production.
# ALLOW_CLERK_LIVE_ON_LOCALHOST="true"

# ---------------------------------------------------------------------------
# Supabase (DB) — required
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME"
# Server-only. Never expose to the client or commit.
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"

# ---------------------------------------------------------------------------
# Stripe (billing) — optional; the app runs with payments disabled if unset
# ---------------------------------------------------------------------------
# Live keys start with sk_live_/whsec_ (from Stripe Dashboard, live mode).
# Test keys start with sk_test_ — use those for local dev.
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"
# The live-mode Pro subscription price ID (Stripe Dashboard > Products). 59 RON/month.
STRIPE_PRO_PRICE_ID="price_CHANGE_ME"
# The live-mode Recruiting Plan price ID (recurring every 6 months, 299 RON).
STRIPE_RECRUITING_PRICE_ID="price_CHANGE_ME"
# Dev-only escape hatch for src/lib/env.ts's validateStripeLocalConfig()
# guard, which otherwise throws if an sk_live_ key is used with a localhost
# NEXT_PUBLIC_APP_URL. Never set this in production.
# ALLOW_STRIPE_LIVE_ON_LOCALHOST="true"
# Kill switch: set to "true" (and redeploy) to instantly pause new checkouts
# without touching the webhook handler. See src/app/api/billing/checkout/route.ts.
# CHECKOUT_DISABLED="true"

# ---------------------------------------------------------------------------
# Anthropic (AI generation) — required for AI features
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY="CHANGE_ME"
RESEND_FROM_EMAIL="Joben <noreply@your-production-domain.example>"

# ---------------------------------------------------------------------------
# Upstash Redis (rate limiting / quotas) — optional; fails open when unset
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="CHANGE_ME"
UPSTASH_REDIS_REST_TOKEN="CHANGE_ME"

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
CRON_SECRET="CHANGE_ME"

# ---------------------------------------------------------------------------
# LaTeX / resume-parser services (VPS, see docker-compose.prod.yml)
# ---------------------------------------------------------------------------
LATEX_SERVICE_URL="https://your-vps-host/api/compile"
LATEX_SERVICE_SECRET="CHANGE_ME"
# LATEX_SERVICE_AUTH_REQUIRED="true"
# LATEX_SERVICE_HEALTH_URL="https://your-vps-host/health"
RESUME_PARSER_URL="https://your-vps-host/parse"
# NEXT_PUBLIC_RESUME_PARSER_URL is only needed if the parser is called client-side.
RESUME_PARSER_SHARED_SECRET="CHANGE_ME"

# ---------------------------------------------------------------------------
# Admin / product analytics
# ---------------------------------------------------------------------------
# Comma-separated Clerk user IDs granted access to /api/admin/* routes.
ADMIN_USER_IDS="user_CHANGE_ME"
NEXT_PUBLIC_GTM_ID="GTM-CHANGE_ME"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="CHANGE_ME"
# Email of the internal/manual-test Clerk account. When signed in with this
# account, PostHogProvider tags the person with is_internal_user: true so it
# can be filtered out of production reports. Optional — leave unset to skip.
NEXT_PUBLIC_INTERNAL_TEST_EMAIL="CHANGE_ME"

# ---------------------------------------------------------------------------
# Alerting (optional — logger.error() posts here when set)
# ---------------------------------------------------------------------------
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/CHANGE_ME"
# ALERT_MIN_LEVEL="error"

# ---------------------------------------------------------------------------
# Private lifetime-access redeem code (non-Stripe upgrade path) — set exactly
# one of these; see src/app/api/billing/redeem-code/route.ts
# ---------------------------------------------------------------------------
# RECRUITING_LIFETIME_CODE="CHANGE_ME_PRIVATE_REDEEM_CODE"
